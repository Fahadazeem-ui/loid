# Discord Developer Portal → Application → Bot
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=

# Optional: use a test server for near-instant command updates.
# Leave blank to register commands globally.
DISCORD_GUILD_ID=

# Anthropic Console API key. Loid uses Claude Sonnet 5 only.
ANTHROPIC_API_KEY=

# Optional port for the local setup / feature page.
PORT=4173
